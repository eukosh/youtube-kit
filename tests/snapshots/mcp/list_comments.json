{
  "annotations": {
    "destructive_hint": false,
    "idempotent_hint": true,
    "open_world_hint": true,
    "read_only_hint": true,
    "title": null
  },
  "description": "Top-level comments on a video, or on all of your channel's videos.\n\nQuota: 1 unit per page of up to 50 results.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "default": 25,
        "description": "Maximum number of comments.",
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "my_channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID or @handle. Omit for the default channel."
      },
      "order": {
        "default": "time",
        "description": "Newest first, or most relevant first.",
        "enum": [
          "relevance",
          "time"
        ],
        "type": "string"
      },
      "page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Continue from a previous result's next_page_token."
      },
      "search": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Only comments containing these words."
      },
      "status": {
        "default": "published",
        "description": "Moderation status to list; spam is what YouTube flagged as likely spam. Anything but published\nis only visible on your own videos.",
        "enum": [
          "published",
          "held",
          "spam",
          "rejected"
        ],
        "type": "string"
      },
      "video": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Video ID or URL. Omit for every video on your channel."
      }
    },
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "items": {
        "items": {
          "properties": {
            "author": {
              "type": "string"
            },
            "author_channel_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "id": {
              "type": "string"
            },
            "likes": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "parent_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Replies only: the comment replied to."
            },
            "published_at": {
              "format": "date-time",
              "type": "string"
            },
            "reply_count": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Top-level comments only."
            },
            "status": {
              "anyOf": [
                {
                  "enum": [
                    "published",
                    "held",
                    "spam",
                    "rejected"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Moderation status, where YouTube reports it."
            },
            "text": {
              "type": "string"
            },
            "updated_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "video_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "id",
            "author",
            "text",
            "published_at"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "next_page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Pass as page_token to continue; null at the end."
      },
      "total_results": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Total reported by YouTube; only an estimate for search."
      }
    },
    "required": [
      "items"
    ],
    "type": "object"
  }
}
