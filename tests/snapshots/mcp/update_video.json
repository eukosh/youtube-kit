{
  "annotations": {
    "destructive_hint": true,
    "idempotent_hint": true,
    "open_world_hint": true,
    "read_only_hint": false,
    "title": null
  },
  "description": "Change a video's metadata. Only the fields you pass change; the rest keep their values.\n\nQuota: 51 units.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "category_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "New category ID (see the video categories listing)."
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "New description."
      },
      "made_for_kids": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Whether the video is made for kids (COPPA)."
      },
      "my_channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID or @handle. Omit for the default channel."
      },
      "privacy": {
        "anyOf": [
          {
            "enum": [
              "private",
              "unlisted",
              "public"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "New privacy status. Making a scheduled video public or unlisted cancels the schedule."
      },
      "publish_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Schedule publication at this date or datetime. The video must end up private."
      },
      "tags": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "New tags, replacing the current ones. An empty list removes all tags."
      },
      "title": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "New title."
      },
      "video": {
        "description": "Video ID or URL.",
        "type": "string"
      }
    },
    "required": [
      "video"
    ],
    "type": "object"
  },
