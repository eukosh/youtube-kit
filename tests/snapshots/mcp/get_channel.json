    "open_world_hint": true,
    "read_only_hint": true,
    "title": null
  },
  "description": "Channel metadata, statistics, and uploads playlist ID.\n\nQuota: 1 unit.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "UC… channel ID, @handle, or channel URL. Omit for your own channel."
      },
      "my_channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID, @handle or exact title. Omit for the default channel."
      }
    },
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "country": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "description": {
        "type": "string"
      },
      "handle": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "id": {
        "type": "string"
      },
      "published_at": {
        "format": "date-time",
        "type": "string"
