{
  "annotations": {
    "destructive_hint": false,
    "idempotent_hint": true,
    "open_world_hint": true,
    "read_only_hint": true,
    "title": null
  },
  "description": "Full metadata, statistics, and status for one or more videos.\n\nVideos that don't exist or aren't visible to you are left out of the result;\nif none are found, that's a not-found error.\n\nQuota: 1 unit.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "my_channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID or @handle. Omit for the default channel."
      },
      "videos": {
        "description": "Video IDs or URLs. Fetched in batches of 50, 1 quota unit per batch.",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "videos"
    ],
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "result": {
        "items": {
          "properties": {
            "ai_content": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Declared to contain realistic AI-made content, as set by this upload or update. YouTube doesn't report it when reading a video."
            },
            "audio_language": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Language spoken in the video, e.g. en-US."
            },
            "category_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "channel_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "channel_title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "duration": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "duration_seconds": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "id": {
              "type": "string"
            },
            "language": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Language of the title and description, e.g. en-US."
            },
            "paid_promotion": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Declared to include paid promotion."
            },
            "privacy": {
              "anyOf": [
                {
                  "enum": [
                    "private",
                    "unlisted",
                    "public"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "publish_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "published_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "stats": {
              "anyOf": [
                {
                  "properties": {
                    "comments": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "likes": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "views": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    }
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "studio_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Edit page in YouTube Studio; only for videos on channels you're logged in to."
            },
            "tags": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "url"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "result"
    ],
    "type": "object",
    "x-fastmcp-wrap-result": true
  }
}
