{
  "annotations": {
    "destructive_hint": true,
    "idempotent_hint": true,
    "open_world_hint": true,
    "read_only_hint": false,
    "title": null
  },
  "description": "Reject comments on your videos, hiding them from viewers. They can still be approved later.\n\nQuota: 50 units.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "ban_author": {
        "default": false,
        "description": "Also reject all future comments on your channel by each comment's author.",
        "type": "boolean"
      },
      "comments": {
        "description": "Comment IDs or links. 50 quota units per 50 comments.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "my_channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID or @handle. Omit for the default channel."
      }
    },
    "required": [
      "comments"
    ],
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "authors_banned": {
        "default": false,
        "type": "boolean"
      },
      "comment_ids": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "status": {
        "enum": [
          "published",
          "held",
          "spam",
          "rejected"
        ],
        "type": "string"
      }
    },
    "required": [
      "comment_ids",
      "status"
    ],
    "type": "object"
  }
}
