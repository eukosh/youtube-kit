{
  "annotations": {
    "destructive_hint": false,
    "idempotent_hint": true,
    "open_world_hint": true,
    "read_only_hint": true,
    "title": null
  },
  "description": "A channel's playlists.\n\nQuota: 1 unit per page of up to 50 results.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "UC… channel ID, @handle, or channel URL. Omit for your own channel, including private playlists."
      },
      "limit": {
        "default": 25,
        "description": "Maximum number of playlists.",
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "my_channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID or @handle. Omit for the default channel."
      },
      "page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Continue from a previous result's next_page_token."
      }
    },
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "items": {
        "items": {
          "properties": {
            "channel_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "id": {
              "type": "string"
            },
            "item_count": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "language": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Language of the title and description, e.g. en-US."
            },
            "privacy": {
              "anyOf": [
                {
                  "enum": [
                    "private",
                    "unlisted",
                    "public"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "published_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "url",
            "title"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "next_page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Pass as page_token to continue; null at the end."
      },
      "total_results": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Total reported by YouTube; only an estimate for search."
      }
    },
    "required": [
      "items"
    ],
    "type": "object"
  }
}
