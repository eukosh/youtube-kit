{
  "annotations": {
    "destructive_hint": true,
    "idempotent_hint": true,
    "open_world_hint": true,
    "read_only_hint": false,
    "title": null
  },
  "description": "Permanently delete one of your playlists. The videos in it are not affected.\n\nWithout confirm, nothing is deleted and the error describes the playlist.\n\nQuota: 52 units.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "confirm": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The playlist ID again, passed only after the user has approved deleting this playlist."
      },
      "my_channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID, @handle or exact title. Omit for the default channel."
      },
      "playlist": {
        "description": "Playlist ID or URL.",
        "type": "string"
      }
    },
    "required": [
      "playlist"
    ],
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "already_gone": {
        "default": false,
        "description": "Nothing to delete: it didn't exist or was already deleted.",
        "type": "boolean"
      },
      "id": {
        "type": "string"
      },
      "kind": {
        "enum": [
          "video",
          "playlist",
          "comment",
          "section"
        ],
        "type": "string"
      }
    },
    "required": [
      "kind",
      "id"
    ],
    "type": "object"
  }
}
