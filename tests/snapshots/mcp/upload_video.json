        "type": "boolean"
      },
      "audio_language": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Language spoken in the video, e.g. en-US."
      },
      "category_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Category ID (see the video categories listing)."
      },
      "description": {
        "default": "",
        "description": "Video description.",
        "type": "string"
      },
      "file": {
        "description": "Path to the local video file.",
        "format": "path",
        "type": "string"
      },
      "language": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Language of the title and description, e.g. en-US."
      },
      "made_for_kids": {
