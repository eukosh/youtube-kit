          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID or @handle. Omit for the default channel."
      },
      "paid_promotion": {
        "default": false,
        "description": "Whether the video includes paid promotion: a sponsorship, product placement, or endorsement.",
        "type": "boolean"
      },
      "privacy": {
        "default": "private",
        "description": "Privacy status. Must be private when publish_at is set.",
