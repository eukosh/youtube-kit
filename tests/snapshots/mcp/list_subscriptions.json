{
  "annotations": {
    "destructive_hint": false,
    "idempotent_hint": true,
    "open_world_hint": true,
    "read_only_hint": true,
    "title": null
  },
  "description": "Channels the authorized user is subscribed to.\n\nQuota: 1 unit per page of up to 50 results.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "default": 25,
        "description": "Maximum number of subscriptions.",
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "my_channel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Which of your logged-in channels to work on: UC… ID, @handle or exact title. Omit for the default channel."
      },
      "order": {
        "default": "alphabetical",
        "description": "Alphabetical, by relevance, or by activity (unread first).",
        "enum": [
          "alphabetical",
          "relevance",
          "unread"
        ],
        "type": "string"
      },
      "page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Continue from a previous result's next_page_token."
      }
    },
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "items": {
        "items": {
          "properties": {
            "channel_id": {
              "type": "string"
            },
            "description": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "id": {
              "type": "string"
            },
            "subscribed_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "channel_id",
            "url"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "next_page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Pass as page_token to continue; null at the end."
      },
      "total_results": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Total reported by YouTube; only an estimate for search."
      }
    },
    "required": [
      "items"
    ],
    "type": "object"
  }
}
