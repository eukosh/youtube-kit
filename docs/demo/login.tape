# The real login wizard, with Google's sign-in stubbed by login_demo.py.
Output out/login.mp4
Source common.tape
Set Width 1280
Set Height 820
Set TypingSpeed 30ms

Hide
Type "source shell.sh login"
Enter
Sleep 2s
Show

Sleep 300ms
Type "ytk auth login"
Sleep 400ms
Enter
Wait+Line /Press Enter/
Sleep 1.6s
Enter
Sleep 300ms
Wait+Line /Press Enter/
Sleep 2s
Enter
Sleep 300ms
Wait+Line /Press Enter/
Sleep 2.4s
Enter
Sleep 300ms
Wait+Line /Press Enter/
Sleep 2.8s
Enter
Sleep 300ms
Wait+Line /Press Enter/
Sleep 2.2s
Enter
Wait+Line /Use it/
Sleep 900ms
Type "y"
Sleep 300ms
Enter
Sleep 4s
